# Application
APP_NAME=Composite Visual AI Agent Coordination System
APP_VERSION=0.1.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
# --- SQLite (local development, default) ---
DATABASE_URL=sqlite+aiosqlite:///./data/futureagent.db
# --- Supabase PostgreSQL (production) ---
# Transaction pooler (port 6543):
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# Session pooler (port 5432, recommended for async if transaction pooler has issues):
# DATABASE_URL=postgresql+asyncpg://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Direct connection (no pooling):
# DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# OpenAI-compatible API (for real LLM mode)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# MiMo API (optional)
MIMO_API_KEY=
MIMO_BASE_URL=

# Default Provider: "mock", "rule", "mimo", "openai_compatible"
DEFAULT_PROVIDER=mock
DEFAULT_MODEL=default

# CORS Origins (JSON array)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost"]
